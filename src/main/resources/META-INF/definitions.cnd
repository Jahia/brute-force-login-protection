<jnt = 'http://www.jahia.org/jahia/nt/1.0'>
<jmix = 'http://www.jahia.org/jahia/mix/1.0'>

[jnt:bruteForceLoginProtection] > jnt:content, jmix:autoPublish
 + bans (jnt:bruteForceLoginProtectionBans) = jnt:bruteForceLoginProtectionBans autocreated
 + auditLog (jnt:bruteForceLoginProtectionAuditLog) = jnt:bruteForceLoginProtectionAuditLog autocreated

[jnt:bruteForceLoginProtectionBans] > jnt:contentFolder
 + * (jnt:bruteForceLoginProtectionBan) = jnt:bruteForceLoginProtectionBan

[jnt:bruteForceLoginProtectionBan] > jnt:content
 - ip (string) mandatory
 - jail (string) mandatory
 - source (string)
 - banned_at (long)
 - banned_until (long)
 - ban_count (long) = 1
 - reason (string)

[jnt:bruteForceLoginProtectionAuditLog] > jnt:contentFolder, jmix:autoSplitFolders
 - j:splitConfig (string) = 'date,property,jcr:created,yyyy/MM/dd' mandatory autocreated protected
 - j:splitNodeType (string) = 'jnt:contentFolder' mandatory autocreated protected
 + * (jnt:bruteForceLoginProtectionAuditEntry) = jnt:bruteForceLoginProtectionAuditEntry

[jnt:bruteForceLoginProtectionAuditEntry] > jnt:content
 - timestamp (long) mandatory
 - event (string) mandatory
 - ip (string)
 - jail (string)
 - source (string)
 - details (string)
